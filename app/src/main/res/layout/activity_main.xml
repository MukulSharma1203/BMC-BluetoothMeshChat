<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050801"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="24dp"
    android:paddingRight="12dp"
    android:paddingBottom="12dp">

    <!-- Terminal Header Banner -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:text="[ SYSTEM LOG: BLE MESH PROTOCOL v1.0 ]"
        android:textColor="#00FF66"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <!-- Identity & Control Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_terminal_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="NODE_ID: "
            android:textColor="#00FF66"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/etMyDeviceId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="monospace"
            android:hint="A / B / C"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:minHeight="48dp"
            android:textColor="#00FF66"
            android:textColorHint="#006622"
            android:textSize="15sp"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnStartMesh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#003311"
            android:fontFamily="monospace"
            android:minHeight="48dp"
            android:text="[ INIT NODE ]"
            android:textColor="#00FF66"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPeerCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:text="ACTIVE_PEERS: 0"
        android:textColor="#00CC44"
        android:textSize="12sp"
        tools:ignore="HardcodedText" />

    <!-- Chat/Payload Messages View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_terminal_box"
        android:padding="8dp" />

    <!-- Packet Transmit Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_terminal_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <EditText
            android:id="@+id/etTargetId"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="monospace"
            android:hint="DEST"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:minHeight="48dp"
            android:textColor="#00FF66"
            android:textColorHint="#006622"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="> "
            android:textColor="#00FF66"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/etMessageText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="monospace"
            android:hint="payload_data..."
            android:importantForAutofill="no"
            android:inputType="textShortMessage"
            android:minHeight="48dp"
            android:textColor="#00FF66"
            android:textColorHint="#006622"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#003311"
            android:fontFamily="monospace"
            android:minHeight="48dp"
            android:text="[ TX ]"
            android:textColor="#00FF66"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- Cyber Console Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:text="SYS_LOGS //"
        android:textColor="#00FF66"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <ScrollView
        android:id="@+id/scrollLogs"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_terminal_box"
        android:padding="6dp">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#00FF66"
            android:textSize="10sp" />
    </ScrollView>

</LinearLayout>